{
  "name": "empress",
  "version": "2.0.0",
  "description": "A blazing fast and multipurpose discord bot with a wide range of features",
  "main": "dist/bot.js",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc && tsc-alias --resolve-full-paths",
    "dev": "tsx --watch src/bot.ts",
    "start": "pm2 start process.json",
    "stop": "pm2 delete all",
    "restart": "pm2 restart all",
    "logs": "pm2 logs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "pnpm exec prisma migrate dev",
    "generate": "pnpm exec prisma generate"
  },
  "keywords": [
    "discord",
    "bot"
  ],
  "author": "Aditya Chaudhary",
  "license": "MIT",
  "dependencies": {
    "@discordjs/builders": "^1.11.2",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "chart.js": "^4.5.0",
    "chartjs-plugin-gradient": "^0.5.1",
    "discord.js": "^14.21.0",
    "discord.js-rate-limiter": "^1.3.2",
    "dotenv": "^16.6.1",
    "glob": "^11.0.3",
    "node-fetch": "^3.3.2",
    "pg": "^8.18.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "pm2": "^6.0.8",
    "poru": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.2.0",
    "prisma": "^7.3.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}